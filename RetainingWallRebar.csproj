<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Revit 2027 corre sobre .NET 10. Para 2025/2026 seria net8.0-windows. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>RetainingWallRebar</AssemblyName>
    <RootNamespace>RetainingWallRebar</RootNamespace>
    <!-- Revit ya carga sus propias DLL: no copiarlas al output -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- El submodulo external/ARBA-comun lo compila Arba.Comun.props (solo su carpeta src/): fuera del
         glob por defecto para no incluir dos veces sus fuentes ni compilar sus tests -->
    <DefaultItemExcludes>$(DefaultItemExcludes);external/**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Codigo comun ARBA (submodulo git en external/ARBA-comun, etiqueta v1.0.0): contrato, particion,
       ARBA - Origen / Codigo, parametros compartidos, migracion, cinta y tema. Se compila como fuente
       dentro de este ensamblado (namespace Arba.Comun), nunca como DLL compartida. -->
  <PropertyGroup>
    <RevitVersion>2027</RevitVersion>
    <!-- permite compilar el proyecto WPF fuera de Windows (CI, Linux) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <Import Project="external/ARBA-comun/Arba.Comun.props" Condition="Exists('external/ARBA-comun/Arba.Comun.props')" />
  <Target Name="ArbaComunPresente" BeforeTargets="BeforeBuild;CoreCompile">
    <Error Condition="!Exists('external/ARBA-comun/Arba.Comun.props')"
           Text="Falta el submodulo external/ARBA-comun (codigo comun ARBA). Clona con --recurse-submodules o ejecuta: git submodule update --init" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2027.*" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2027.*" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <None Update="config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Copia automatica al directorio de add-ins de Revit al compilar en Debug (solo en Windows) -->
  <Target Name="CopyToRevit" AfterTargets="Build" Condition="'$(Configuration)'=='Debug' AND $([MSBuild]::IsOSPlatform('Windows'))">
    <PropertyGroup>
      <AddinDir>$(AppData)\Autodesk\Revit\Addins\2027\RetainingWallRebar\</AddinDir>
    </PropertyGroup>
    <MakeDir Directories="$(AddinDir)" />
    <Copy SourceFiles="$(TargetPath);$(ProjectDir)config.json" DestinationFolder="$(AddinDir)" />
    <Copy SourceFiles="$(ProjectDir)RetainingWallRebar.addin" DestinationFolder="$(AppData)\Autodesk\Revit\Addins\2027\" />
  </Target>

</Project>
